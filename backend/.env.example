DJANGO_DEBUG=1
# Generate your own random key before production deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
# Leave empty to use SQLite locally. Use PostgreSQL for shared deployment.
DATABASE_URL=
# DATABASE_URL=postgresql://neighborrow:password@localhost:5432/neighborrow
# For production: DJANGO_DEBUG=0 and HTTPS. Trusted proxy is opt-in.
DJANGO_TRUST_PROXY=0
